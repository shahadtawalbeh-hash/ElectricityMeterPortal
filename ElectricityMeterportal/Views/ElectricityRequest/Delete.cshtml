@model ElectricityMeterportal.Models.ElectricityRequest
@{

	ViewData["Tiltle"] = "Delete Request  ";
}
<h1> Delete Request </h1>
<h3>Are you sure you want to delete this Request? </h3>
<hr />

<div>
	<d1 class="row">
		<dt class="col-sm-3">
			National Id
		</dt>
		<dd class="col-sm-9">
			@Model.NationalID
		</dd>
		<dt class="col-sm-3">
			Full Name
		</dt>
		<dd class="col-sm-9">
			@Model.FullName
		</dd>
		<dt class="col-sm-3">
			Phone Number
		</dt>
		<dd class="col-sm-9">
			@Model.PhoneNumber
		</dd>
		<dt class="col-sm-3">
			Addrss
		</dt>
		<dd class="col-sm-9">
			@Model.Address
		</dd>
		<dt class="col-sm-3">
			Meter Type
		</dt>
		<dd class="col-sm-9">
			@Model.MeterType
		</dd>
		<dt class="col-sm-3">
			Status
		</dt>
		<dd class="col-sm-9">
			@Model.status
		</dd>
	</d1>
	<form asp-action="Delete" method="post">
		<input type="hidden" asp-for="ID" />
		<button type="submit" class="btn btn-danger">Delete</button>
		<a asp-action="Index" class="btn btn_secondary">cancel</a>


	</form>

</div>

