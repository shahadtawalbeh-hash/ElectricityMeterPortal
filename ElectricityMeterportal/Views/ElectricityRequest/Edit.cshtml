@model ElectricityMeterportal.Models.ElectricityRequest
@{
	ViewData["Title"] = "Edit Request";

}
<h1>Edit Requests </h1>
<hr />
<div class="row">
	<div class="col-md-7">

		<form asp-action="Edit" method="post">
		
			<input type="hidden" asp-for="ID" />
			<div class="form-group mb-3">
				<label asp-for="NationalID">National ID</label>
				<input asp-for="NationalID" class="form-control" />
				<span asp-validation-for="NationalID" class="text-danger"></span>
			</div>
			<div class="form-group mb-3">
				<label asp-for=" FullName">Full Name</label>
				<input asp-for="FullName" class="form-control" />
				<span asp-validation-for="FullName" class="text-danger"> </span>
			</div>
			<div class="form-group mb-3">
				<label asp-for=" PhoneNumber">Phone Number</label>
				<input asp-for="PhoneNumber" class="form-control" />
				<span asp-validation-for="PhoneNumber" class="text-danger"> </span>
			</div>
			<div class="form-group mb-3">
				<label asp-for=" Address">Address</label>
				<input asp-for="Address" class="form-control" />
				<span asp-validation-for="Address" class="text-danger"> </span>
			</div>
			<div class="form-group mb-3">
				<label asp-for=" MeterType">Meter Type</label>
				<select asp-for="MeterType" class="form-control">
					<option value="">-- Select Meter Type -- </option>
					<option value="Residential">Residential</option>
					<option value="Commercial">Commercial</option>
					<option value="Industrial">Industrial</option>
				</select>
				<span asp-validation-for="MeterType" class="text-danger"> </span>
			</div>
			<input type="hidden" asp-for="status" />
			<button type="submit" class="btn btn-primary"> Save Changes</button>
			<a asp-action="Index" class="btn btn secondary"> Cancel</a>

		</form>
	</div>
</div>

