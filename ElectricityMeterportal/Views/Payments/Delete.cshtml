@model ElectricityMeterportal.Models.Payment
@{
    ViewData["Title"] = "Delete Payment";
}
<h1>Delete Payment</h1>
<hr />
<div class="row">
    <div class="col-md-7">
        <div class="alert alert-danger">
            Are you sure you want to delete this payment?
        </div>
        <dl class="row">
            <dt class="col-sm-5">
                Bill ID
            </dt>
            <dd class="col-sm-7">
                @Model.BillId
            </dd>
            <dt class="col-sm-5">
                Meter Number
            </dt>
            <dd class="col-sm-7">
                @Model.Bill.Meter.MeterNumber
            </dd>
            <dt class="col-sm-5">
                Customer Name
            </dt>
            <dd class="col-sm-7">
                @Model.Bill.Meter.CustomerName
            </dd>
            <dt class="col-sm-5">
                Amount Paid
            </dt>
            <dd class="col-sm-7">
                @Model.AmountPaid
            </dd>
            <dt class="col-sm-5">
                Payment Date
            </dt>
            <dd class="col-sm-7">
                @Model.PaymentDate?.ToString("yyyy-MM-dd")
            </dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden"
                   asp-for="PaymentId" />
            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>
            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>