@model IEnumerable<ElectricityMeterportal.Models.Payment>
@{
    ViewData["Title"] = "Payments";
}
<h1>Payments</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">
        Add New Payment
    </a>
</p>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Bill ID</th>
            <th>Meter Number</th>
            <th>Amount Paid</th>
            <th>Payment Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payment in Model)
        {
            <tr>
                <td>
                    @payment.BillId
                </td>
                <td>
                    @payment.Bill.Meter.MeterNumber
                </td>
                <td>
                    @payment.AmountPaid
                </td>
                <td>
                    @payment.PaymentDate?.ToString("yyyy-MM-dd")
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@payment.PaymentId"
                       class="btn btn-info btn-sm">
                        Details
                    </a>
                    <a asp-action="Edit"
                       asp-route-id="@payment.PaymentId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@payment.PaymentId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>