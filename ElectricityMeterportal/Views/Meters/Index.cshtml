@model IEnumerable<ElectricityMeterportal.Models.Meter>
@{
	ViewData["Title"] = "Meters";

}
<h1> Meters </h1>
<p>
	<a asp-action="Create" class="btn btn-primary">Add New Meter</a>

</p>
<table class="table">

	<thead>
		<tr>
			<th>Meter Number</th>
			<th>Customer Name</th>
			<th>Address</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var meter in Model)
		{
			<tr>
				<td>@meter.MeterNumber</td>
				<td>@meter.CustomerName</td>
				<td>@meter.Address</td>
				<td>
					<a asp-action="Edit" asp-route-id="@meter.MeterId" class="btn btn-warning">Edit</a>
					<a asp-action="Delete" asp-route-id="@meter.MeterId" class="btn btn-danger">Delete</a>
				</td>
			</tr>	
		}
	</tbody>
</table>