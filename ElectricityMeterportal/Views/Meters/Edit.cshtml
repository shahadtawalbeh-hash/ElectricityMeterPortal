@model ElectricityMeterportal.Models.Meter
@{
	ViewData["Title"] = "Edit Meter";

}
<h1>Edit Meter </h1>
<hr />
<div class="row">
	<div class="col-md-7">

		<form asp-action="Edit" method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" asp-for="MeterId" />
			<div class="form-group mb-3">
				<label asp-for="MeterNumber" class="control-label">
					Meter Number
				</label>
				<input asp-for="MeterNumber" class="form-control" />
				<span asp-validation-for="MeterNumber" class="text-danger"></span>
			</div>
			<div class="form-group mb-3">
				<label asp-for=" CustomerName" class="control-label">
					customer Name
				</label>
				<input asp-for="CustomerName" class="form-control" />
				<span asp-validation-for="CustomerName" class="text-danger"> </span>
			</div>
			<div class="form-group mb-3">
				<label asp-for=" Address" class="control-label">
					Address
				</label>
				<input asp-for="Address" class="form-control" />
				<span asp-validation-for="Address" class="text-danger"> </span>
			</div>
			<button type="submit" class="btn btn-primary"> Add Meter</button>
			<a asp-action="Index" class="btn btn secondary"> Back to List</a>

		</form>
	</div>
</div>

