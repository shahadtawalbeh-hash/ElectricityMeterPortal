@model ElectricityMeterportal.Models.Meter
@{

	ViewData["Tiltle"] = "Delete Meter  ";
}
	<h1> Delete Meter </h1>
	<h3>Are you sure you want to delete this meter? </h3>
	<hr />

	<div>
		<d1 class="row">
			<dt class="col-sm-3">
				Meter Number
			</dt>
			<dd class="col-sm-9">
				@Model.MeterNumber
			</dd>
			<dt class="col-sm-3">
				Customer Name
			</dt>
			<dd class="col-sm-9">
				@Model.CustomerName
			</dd>
			<dt class="col-sm-3">
				Address
			</dt>
			<dd class="col-sm-9">
				@Model.Address
			</dd>
		</d1>
		<form asp-action="Delete" method="post">
			<input type="hidden" asp-for="MeterId" />
			<button type="submit" class="btn btn-danger">Delete</button>
			<a asp-action="Index" class="btn btn_secondary">cancel</a>


		</form>

	</div>
