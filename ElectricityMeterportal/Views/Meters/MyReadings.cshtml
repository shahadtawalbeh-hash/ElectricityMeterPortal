@model IEnumerable<ElectricityMeterportal.Models.MeterReading>

@{
    ViewData["Title"] = "My Meter Readings";
}

<h1>My Meter Readings</h1>

<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        No meter readings are available yet.
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Meter Number</th>
                <th>Reading</th>
                <th>Reading Date</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reading in Model)
            {
                <tr>
                    <td>@reading.Meter.MeterNumber</td>
                    <td>@reading.ReadingValue</td>
                    <td>@reading.ReadingDate</td>
                </tr>
            }
        </tbody>
    </table>
}