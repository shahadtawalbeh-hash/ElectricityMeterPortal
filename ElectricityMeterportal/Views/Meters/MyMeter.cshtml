@model ElectricityMeterportal.Models.Meter

@{
    ViewData["Title"] = "My Meter";
}

<h1>My Meter</h1>

<hr />

@if (Model == null)
{
    <div class="alert alert-info">
        You don't have an active meter yet.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">

            <h4>Meter Information</h4>

            <hr />

            <p>
                <strong>Meter Number:</strong>
                @Model.MeterNumber
            </p>

            <p>
                <strong>Customer Name:</strong>
                @Model.CustomerName
            </p>

            <p>
                <strong>Address:</strong>
                @Model.Address
            </p>

            <p>
                <strong>Created At:</strong>
                @Model.CreatedAt
            </p>

        </div>
    </div>
}