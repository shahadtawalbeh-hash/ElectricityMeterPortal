@model IEnumerable<ElectricityMeterportal.Models.Bill>
@{
    ViewData["Title"] = "Bills";
}
<h1>Bills</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">
        Add New Bill
    </a>
</p>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Meter Number</th>
            <th>Previous Reading</th>
            <th>Current Reading</th>
            <th>Consumption</th>
            <th>Amount</th>
            <th>Bill Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bill in Model)
        {
            <tr>
                <td>
                    @bill.Meter.MeterNumber
                </td>
                <td>
                    @bill.PreviousReading
                </td>
                <td>
                    @bill.CurrentReading
                </td>
                <td>
                    @bill.Consumption
                </td>
                <td>
                    @bill.Amount
                </td>
                <td>
                    @bill.BillDate?.ToString("yyyy-MM-dd")
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@bill.BillId"
                       class="btn btn-info btn-sm">
                        Details
                    </a>
                    <a asp-action="Edit"
                       asp-route-id="@bill.BillId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>
                    <a asp-action="Delete"
                       asp-route-id="@bill.BillId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>