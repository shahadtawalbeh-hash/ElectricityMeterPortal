@model ElectricityMeterportal.Models.Bill
@{
    ViewData["Title"] = "Edit Bill";
}
<h1>Edit Bill</h1>
<hr />
<div class="row">
    <div class="col-md-7">
        <form asp-action="Edit" method="post">
            <input type="hidden"
                   asp-for="BillId" />
            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>
            <div class="form-group mb-3">
                <label asp-for="MeterId"
                       class="control-label">
                    Meter
                </label>
                <select asp-for="MeterId"
                        asp-items="ViewBag.Meters"
                        class="form-control">
                    <option value="">
                        -- Select Meter --
                    </option>
                </select>
                <span asp-validation-for="MeterId"
                      class="text-danger">
                </span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PreviousReading"
                       class="control-label">
                    Previous Reading
                </label>
                <input asp-for="PreviousReading"
                       class="form-control"
                       type="number"
                       step="0.01" />
                <span asp-validation-for="PreviousReading"
                      class="text-danger">
                </span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CurrentReading"
                       class="control-label">
                    Current Reading
                </label>
                <input asp-for="CurrentReading"
                       class="form-control"
                       type="number"
                       step="0.01" />
                <span asp-validation-for="CurrentReading"
                      class="text-danger">
                </span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Amount"
                       class="control-label">
                    Amount
                </label>
                <input asp-for="Amount"
                       class="form-control"
                       type="number"
                       step="0.01" />
                <span asp-validation-for="Amount"
                      class="text-danger">
                </span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="BillDate"
                       class="control-label">
                    Bill Date
                </label>
                <input asp-for="BillDate"
                       class="form-control"
                       type="date" />
                <span asp-validation-for="BillDate"
                      class="text-danger">
                </span>
            </div>
            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>
            <a asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>
        </form>
    </div>
</div>