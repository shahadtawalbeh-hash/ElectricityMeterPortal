@model ElectricityMeterportal.Models.Bill
@{
    ViewData["Title"] = "Delete Bill";
}
<h1>Delete Bill</h1>
<hr />
<div class="row">
    <div class="col-md-7">
        <div class="alert alert-danger">
            Are you sure you want to delete this bill?
        </div>
        <dl class="row">
            <dt class="col-sm-5">
                Meter Number
            </dt>
            <dd class="col-sm-7">
                @Model.Meter.MeterNumber
            </dd>
            <dt class="col-sm-5">
                Customer Name
            </dt>
            <dd class="col-sm-7">
                @Model.Meter.CustomerName
            </dd>
            <dt class="col-sm-5">
                Consumption
            </dt>
            <dd class="col-sm-7">
                @Model.Consumption
            </dd>
            <dt class="col-sm-5">
                Amount
            </dt>
            <dd class="col-sm-7">
                @Model.Amount
            </dd>
            <dt class="col-sm-5">
                Bill Date
            </dt>
            <dd class="col-sm-7">
                @Model.BillDate?.ToString("yyyy-MM-dd")
            </dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden"
                   asp-for="BillId" />
            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>
            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>