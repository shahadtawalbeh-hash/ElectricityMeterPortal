@{
	ViewData["Title"]=" Account ";


}
<div class="row justify-content-center mt-5">
	<div class="col-md-6">
		<div class="card shadow-sm">
			<div class=" card-body p-4 text-center">
				<h2 class="mb-4">Login</h2>
				<p class="text-muted mb-4">Please select your account type: </p>
				<div class="d-grid gap-3">
					<a asp-controller="Account" asp-action="CitizenLogin" class="btn btn-primary btn-lg">Citizen Login</a>
					<a asp-controller="Account" asp-action="EmployeeLogin" class="btn btn-primary btn-lg">Employee Login</a>
				</div>
			</div>
		</div>
	</div>


</div>